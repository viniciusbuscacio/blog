---
import Layout from '../../layouts/Layout.astro';
import PostCard from '../../components/PostCard.astro';
import Pagination from '../../components/Pagination.astro';
import SearchBar from '../../components/SearchBar.astro';
import { getCollection } from 'astro:content';
import type { Lang } from '../../i18n';
import { useTranslations } from '../../i18n';

const lang: Lang = 'en';
const t = useTranslations(lang);

const allPosts = (await getCollection('posts'))
  .filter((post) => post.data.lang === lang)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const allTags = [...new Set(allPosts.flatMap((post) => post.data.tags))].sort();

const POSTS_PER_PAGE = 9;
const currentPage = Number(Astro.url.searchParams.get('page') || '1');
const totalPages = Math.max(1, Math.ceil(allPosts.length / POSTS_PER_PAGE));
const posts = allPosts.slice((currentPage - 1) * POSTS_PER_PAGE, currentPage * POSTS_PER_PAGE);
---

<Layout title={t('nav.home')} lang={lang} description="Tech blog by Vinicius Buscacio — Cloud, AI, Microsoft Teams, automation">
  <section class="hero">
    <h1 set:html={`Hi, I'm <em>Vinicius</em>`} />
    <p>Cloud Solution Architect at Microsoft. I write about Microsoft Teams, AI, tech and whatever comes to mind.</p>
  </section>

  <SearchBar placeholder={t('search.placeholder')} lang={lang} />

  <section class="tag-row" id="tag-filters">
    <button class="tag-filter is-active" data-tag="all">{t('filter.all')}</button>
    {allTags.map((tag) => (
      <button class="tag-filter" data-tag={tag}>{tag}</button>
    ))}
  </section>

  <section class="post-grid" id="posts-grid">
    {posts.map((post) => (
      <div class="post-item" data-tags={post.data.tags.join(',')}>
        <PostCard
          title={post.data.title}
          description={post.data.description}
          date={post.data.date}
          tags={post.data.tags}
          slug={post.data.slug}
          lang={lang}
          image={post.data.image}
        />
      </div>
    ))}
  </section>

  {posts.length === 0 && <p class="no-results">No posts yet. Coming soon! 🚀</p>}
  <p id="no-results" class="no-results hidden">No posts found.</p>

  {totalPages > 1 && (
    <Pagination currentPage={currentPage} totalPages={totalPages} lang={lang} basePath={`/${lang}`} />
  )}
</Layout>

<script is:inline>
  document.querySelectorAll('.tag-filter').forEach(btn => {
    btn.addEventListener('click', () => {
      const allButton = document.querySelector('.tag-filter[data-tag="all"]');
      const wasActive = btn.classList.contains('is-active');
      const clickedTag = btn.dataset.tag;
      const tag = clickedTag !== 'all' && wasActive ? 'all' : clickedTag;
      const activeButton = tag === 'all' ? allButton : btn;

      document.querySelectorAll('.tag-filter').forEach(b => b.classList.remove('is-active'));
      activeButton?.classList.add('is-active');

      const items = document.querySelectorAll('.post-item');
      let visible = 0;
      items.forEach(item => {
        if (tag === 'all' || item.dataset.tags.split(',').includes(tag)) {
          item.style.display = '';
          visible++;
        } else {
          item.style.display = 'none';
        }
      });

      document.getElementById('no-results').classList.toggle('hidden', visible > 0);
    });
  });
</script>
