---
import '../styles/global.css';
import { languages, type Lang, useTranslations, getLocalizedPath } from '../i18n';

interface Props {
  title: string;
  description?: string;
  lang?: Lang;
  image?: string;
  canonicalUrl?: string;
  type?: 'website' | 'article';
  publishedDate?: Date;
  tags?: string[];
}

const {
  title,
  description = 'Blog técnico de Vinicius Buscacio — Cloud, IA, Microsoft Teams',
  lang = 'pt',
  image,
  type = 'website',
  publishedDate,
  tags = [],
} = Astro.props;

const t = useTranslations(lang);
const currentPath = Astro.url.pathname.replace(`/${lang}`, '') || '/';
const canonicalUrl = `https://viniciusbuscacio.blog${Astro.url.pathname}`;
const ogImage = image || 'https://viniciusbuscacio.blog/og-default.png';
const fullTitle = `${title} | Vinicius Buscacio`;
const GA_ID = 'G-M5LPZG24SP';
---

<!doctype html>
<html lang={lang} data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {tags.length > 0 && <meta name="keywords" content={tags.join(', ')} />}
    <meta name="author" content="Vinicius Buscacio" />

    <meta property="og:type" content={type} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content="Vinicius Buscacio" />
    <meta property="og:locale" content={lang === 'pt' ? 'pt_BR' : lang === 'es' ? 'es_ES' : 'en_US'} />
    {publishedDate && <meta property="article:published_time" content={publishedDate.toISOString()} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {Object.keys(languages).map((code) => (
      <link rel="alternate" hreflang={code} href={`https://viniciusbuscacio.blog${getLocalizedPath(currentPath, code as Lang)}`} />
    ))}
    <link rel="alternate" hreflang="x-default" href={`https://viniciusbuscacio.blog/pt${currentPath}`} />

    {GA_ID !== 'G-XXXXXXXXXX' && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`}></script>
        <script is:inline define:vars={{ GA_ID }}>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', GA_ID);
        </script>
      </>
    )}

    <script type="application/ld+json" set:html={JSON.stringify(
      type === 'article' ? {
        "@context": "https://schema.org",
        "@type": "Article",
        "headline": title,
        "description": description,
        "author": { "@type": "Person", "name": "Vinicius Buscacio" },
        "datePublished": publishedDate?.toISOString(),
        "image": ogImage,
        "url": canonicalUrl,
      } : {
        "@context": "https://schema.org",
        "@type": "WebSite",
        "name": "Vinicius Buscacio",
        "url": "https://viniciusbuscacio.blog",
        "description": description,
        "author": { "@type": "Person", "name": "Vinicius Buscacio" },
      }
    )} />

    <script is:inline>
      (function () {
        var saved = localStorage.getItem('blog-html-effectiveness-theme') || 'light';
        if (!/^(light|dark)$/.test(saved)) saved = 'light';
        document.documentElement.setAttribute('data-theme', saved);
      })();
    </script>
  </head>
  <body>
    <button class="theme-toggle" type="button" aria-label="Theme: light" title="Theme: light" data-theme-toggle>
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <circle cx="12" cy="12" r="4"></circle>
        <path d="M12 2.75v2.5M12 18.75v2.5M4.42 4.42l1.77 1.77M17.81 17.81l1.77 1.77M2.75 12h2.5M18.75 12h2.5M4.42 19.58l1.77-1.77M17.81 6.19l1.77-1.77"></path>
      </svg>
    </button>

    <div class="site-shell">
      <header class="topbar">
        <a href={getLocalizedPath('/', lang)} class="brand">https://viniciusbuscacio.blog</a>
        <nav class="navbar" aria-label="Principal">
          <span class="nav-group nav-main">
            <a href={getLocalizedPath('/', lang)} class="nav-pill">{t('nav.home')}</a>
            <a href={getLocalizedPath('/about', lang)} class="nav-pill">{t('nav.about')}</a>
            <a href="https://github.com/viniciusbuscacio" target="_blank" rel="noopener" class="nav-pill">GitHub</a>
            <a href="https://www.linkedin.com/in/viniciusbuscacio" target="_blank" rel="noopener" class="nav-pill">LinkedIn</a>
          </span>
          <span class="nav-group lang-group">
            {Object.entries(languages).map(([code]) => (
              <a
                href={getLocalizedPath(currentPath, code as Lang)}
                class:list={['lang-pill', code === lang && 'active']}
              >
                {code.toUpperCase()}
              </a>
            ))}
          </span>
        </nav>
      </header>

      <main>
        <slot />
      </main>

      <footer class="site-footer">
        <span></span>
        <span>© 2026 Vinicius Buscacio · <a href="https://astro.build">Astro</a></span>
      </footer>
    </div>

    <script is:inline>
      (function () {
        var modes = ['light', 'dark'];
        var button = document.querySelector('[data-theme-toggle]');
        if (!button) return;

        var icons = {
          light: '<svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2.75v2.5M12 18.75v2.5M4.42 4.42l1.77 1.77M17.81 17.81l1.77 1.77M2.75 12h2.5M18.75 12h2.5M4.42 19.58l1.77-1.77M17.81 6.19l1.77-1.77"></path></svg>',
          dark: '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.25 14.2A7.7 7.7 0 0 1 9.8 3.75a8.15 8.15 0 1 0 10.45 10.45Z"></path></svg>'
        };

        function currentTheme() {
          var theme = document.documentElement.getAttribute('data-theme') || 'light';
          return modes.indexOf(theme) === -1 ? 'light' : theme;
        }

        function apply(theme) {
          document.documentElement.setAttribute('data-theme', theme);
          localStorage.setItem('blog-html-effectiveness-theme', theme);
          button.innerHTML = icons[theme];
          button.setAttribute('aria-label', 'Theme: ' + theme);
          button.setAttribute('title', 'Theme: ' + theme);
        }

        apply(currentTheme());
        button.addEventListener('click', function () {
          apply(modes[(modes.indexOf(currentTheme()) + 1) % modes.length]);
        });
      })();
    </script>
  </body>
</html>
